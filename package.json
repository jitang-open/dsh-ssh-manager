{
  "name": "dsh-ssh-manager",
  "version": "1.1.1",
  "private": true,
  "description": "SSH 主机管理器：会话标题栏右侧入口 + 全高浮层面板，保存远程主机并在其上执行命令。",
  "type": "module",
  "license": "MIT",
  "icon": "./icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "icon.svg",
    "locale/*.json",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "scripts": {
    "check": "node scripts/check-manifest.mjs"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "ssh"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  }
}
